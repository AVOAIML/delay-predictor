# Copy to `.env.local` (git-ignored) and fill in. Read by both the host
# (`maxxflow_core.settings` loads it after the APP_ENV profile) and the
# containers (compose mounts it via `env_file`), so one file drives both.
#
#   cp .env.local.example .env.local
#
# Nothing here has a safe default — leave a line commented out to keep the
# deterministic stub from config/profiles/local.env.

# ---------------------------------------------------------------------------
# M3's LLM agents: the Review Agent's judge, and the Weight Agent's two-stage
# cold start. Both are inert on the stub provider, which returns prose rather
# than JSON — the judge lands on `fallback_template` and the Weight Agent falls
# back to its domain prior.
#
# Azure AI Foundry is NOT Azure OpenAI. It is a separate data plane with its
# own endpoint and key, and it is the one that serves the Anthropic catalogue,
# so the AZURE_OPENAI_* settings cannot reach a Claude deployment.
# ---------------------------------------------------------------------------

# LLM_PROVIDER=azure_ai

# From the Foundry portal, the resource endpoint. Either spelling works — the
# adapter appends Foundry's /models inference route when the base carries no
# path of its own.
#   https://<resource>.services.ai.azure.com
# AZURE_AI_API_BASE=

# AZURE_AI_API_KEY=

# The DEPLOYMENT name exactly as your Foundry deployment list shows it — not a
# vendor model name like "claude-sonnet-4-5". Never guessed: the provider
# refuses to construct without it rather than failing later at call time.
# LLM_MODEL_ID=

# ---------------------------------------------------------------------------
# Optional switches
# ---------------------------------------------------------------------------

# Skip the judging call entirely and publish the deterministic templates.
# Same outcome as an unreachable provider, without the spend.
# M3_REVIEW_AGENT_LLM_ENABLED=false

# Opt-in execution trace. The second flag is the ONLY path through which the
# judge's raw prompt or response text is ever logged, so leave it off unless
# you are actively debugging a verdict.
# M3_REVIEW_AGENT_TRACE_ENABLED=true
# M3_REVIEW_AGENT_TRACE_INCLUDE_CONTENT=true

# The Weight Agent has the same pair.
# M3_WEIGHT_AGENT_TRACE_ENABLED=true
# M3_WEIGHT_AGENT_TRACE_INCLUDE_CONTENT=true
