  addressLine01       String    @map("address_line_01") @db.VarChar(255)
  addressLine02       String?   @map("address_line_02") @db.VarChar(255)
  city                String    @db.VarChar(100)
  state               String    @db.VarChar(100)
  postalCode          String    @map("postal_code") @db.VarChar(20)
  countryId           String    @map("country_id") @db.Uuid // FK to master_data (COUNTRY)
  primaryContactName  String?   @map("primary_contact_name") @db.VarChar(255)
  primaryContactEmail String?   @map("primary_contact_email") @db.VarChar(255)
  primaryContactPhone String?   @map("primary_contact_phone") @db.VarChar(50)
  statusId            String    @map("status_id") @db.Uuid // FK to master_data (STATUS)
