  shippingState         String?   @map("shipping_state") @db.VarChar(100)
  shippingPostalCode    String?   @map("shipping_postal_code") @db.VarChar(30)
  shippingCountryId     String?   @map("shipping_country_id") @db.Uuid // FK to master_data (COUNTRY)
  primaryContactName  String?   @map("primary_contact_name") @db.VarChar(255)
  primaryContactEmail String?   @map("primary_contact_email") @db.VarChar(255)
  primaryContactPhone String?   @map("primary_contact_phone") @db.VarChar(16)
  lifeCycleStatusId      String    @map("life_cycle_status_id") @db.Uuid // FK to master_data (CONTACT_LIFECYCLE_STATUS: Customer, Contact)
  customElements         Json?     @map("custom_elements") @db.JsonB
  integrationCustomerId    String?   @map("integration_customer_id") @db.VarChar(50)
  integrationSyncStatus    String?   @map("integration_sync_status") @db.VarChar(20) // pending | synced | failed
  integrationSyncedAt      DateTime? @map("integration_synced_at") @db.Timestamp(6)
  addedDate              DateTime  @default(now()) @map("added_date") @db.Timestamp(6)
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt           DateTime  @updatedAt @map("updated_at") @db.Timestamp(6)
  createdBy           String    @map("created_by") @db.Uuid
  updatedBy           String?   @map("updated_by") @db.Uuid
  deletedAt           DateTime? @map("deleted_at") @db.Timestamp(6)

  country_rel         MasterData?           @relation("ContactCountry", fields: [countryId], references: [id], onDelete: SetNull)
  shippingCountry_rel MasterData?           @relation("ContactShippingCountry", fields: [shippingCountryId], references: [id], onDelete: SetNull)
  lifeCycleStatus_rel MasterData            @relation("ContactLifeCycleStatus", fields: [lifeCycleStatusId], references: [id], onDelete: Restrict)
  quotations          Quotation[]           @relation("QuotationContact")
  organisations       OrganisationContact[]

  @@unique([email])
  @@index([name])
  @@index([email])
  @@index([lifeCycleStatusId])
  @@index([addedDate])
  @@map("contacts")
}

/// Product - Manufacturing product definition
model Product {
  id                 String    @id @default(uuid()) @db.Uuid
  sku                String    @unique @db.VarChar(100)
  name               String    @db.VarChar(255)
  productTypeId      String    @map("product_type_id") @db.Uuid // FK → MasterData (PRODUCT_TYPE)
  salesPrice         Decimal   @map("sales_price") @db.Decimal(12, 2)
  unitCost           Decimal   @map("unit_cost") @db.Decimal(12, 2)
  projectType        String    @map("project_type") @db.VarChar(50) // catalog_item, non_catalog_item
  route              String    @default("manufacture") @db.VarChar(50) // manufacture, buy
  defaultWarehouseId String    @map("default_warehouse_id") @db.Uuid // FK → Warehouse (required)
  onHand             Decimal   @default(0) @map("on_hand") @db.Decimal(12, 2)
  forecasted         Decimal   @default(0) @db.Decimal(12, 2)
  reservedQuantity   Decimal   @default(0) @map("reserved_quantity") @db.Decimal(12, 2)
  notes              String?   @db.Text
  imageUrl           String?   @map("image_url") @db.VarChar(500)
  customElements     Json?     @map("custom_elements") @db.JsonB
  integrationItemId    String?   @map("integration_item_id") @db.VarChar(50)
  integrationSyncStatus String?  @map("integration_sync_status") @db.VarChar(20) // pending | synced | failed
  integrationSyncedAt  DateTime? @map("integration_synced_at") @db.Timestamp(6)
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt          DateTime  @updatedAt @map("updated_at") @db.Timestamp(6)
  createdBy          String    @map("created_by") @db.Uuid
  updatedBy          String?   @map("updated_by") @db.Uuid
  deletedAt          DateTime? @map("deleted_at") @db.Timestamp(6)

  // ── Relations ──────────────────────────────────────────────────────────────
  productType           MasterData                    @relation("ProductType", fields: [productTypeId], references: [id])
  defaultWarehouse      Warehouse                     @relation("ProductDefaultWarehouse", fields: [defaultWarehouseId], references: [id], onDelete: Restrict)
  alternativeWarehouses ProductAlternativeWarehouse[]
  bomAsProduct          Bom?                          @relation("BomProduct")
  bomComponents         BomComponent[]                @relation("BomComponentProduct")
  quotationLineItems    QuotationLineItem[]           @relation("QuotationLineItem")
  manufacturingOrders   ManufacturingOrder[]          @relation("MOProduct")
  moComponents          MOComponent[]                 @relation("MOComponentProduct")

  @@unique([name])
  @@index([deletedAt])
  @@index([productTypeId])
  @@index([sku])
  @@index([defaultWarehouseId])
  @@map("products")
}

/// ProductAlternativeWarehouse - Join table for product ↔ alternative warehouse many-to-many
model ProductAlternativeWarehouse {
  productId   String @map("product_id") @db.Uuid
  warehouseId String @map("warehouse_id") @db.Uuid

  product   Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  warehouse Warehouse @relation("ProductAlternativeWarehouse", fields: [warehouseId], references: [id], onDelete: Cascade)

  @@id([productId, warehouseId])
  @@index([productId])
  @@index([warehouseId])
  @@map("product_alternative_warehouses")
}

/// WorkCenter - Manufacturing work center configuration
model WorkCenter {
  id                  String    @id @default(uuid()) @db.Uuid
  name                String    @map("name") @db.VarChar(255)
  code                String    @map("code") @db.VarChar(50)
  workingHoursId      String    @map("working_hours_id") @db.Uuid // FK to MasterData (WORKING_HOURS category)
  setupTime           Float?    @map("setup_time")
  cleanupTime         Float?    @map("cleanup_time")
  costPerHour         Float?    @map("cost_per_hour") // Cost per hour for the work center
  employeeCostPerHour Float?    @map("employee_cost_per_hour") // Cost per hour per employee
  allowedEmployees    String[]  @default([]) @map("allowed_employees") // Array of employee IDs
  description         String?   @db.Text
  customElements      Json?     @map("custom_elements") @db.JsonB
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt           DateTime  @updatedAt @map("updated_at") @db.Timestamp(6)
  createdBy           String    @map("created_by") @db.Uuid
  updatedBy           String?   @map("updated_by") @db.Uuid
  deletedAt           DateTime? @map("deleted_at") @db.Timestamp(6)

  workingHours           MasterData              @relation("WorkCenterWorkingHours", fields: [workingHoursId], references: [id])
  alternativeWorkCenters WorkCenterAlternative[] @relation("WorkCenterHasAlternatives")
  isAlternativeFor       WorkCenterAlternative[] @relation("WorkCenterIsAlternative")
  operations             Operations[]
  workOrders             WorkOrder[]             @relation("WorkOrderWorkCenter")

  @@unique([code])
  @@index([deletedAt])
  @@index([workingHoursId])
  @@map("work_centers")
}

/// WorkCenterAlternative - Join table for work center self-relation (alternative work centers)
model WorkCenterAlternative {
  workCenterId  String @map("work_center_id") @db.Uuid
  alternativeId String @map("alternative_id") @db.Uuid

  workCenter  WorkCenter @relation("WorkCenterHasAlternatives", fields: [workCenterId], references: [id], onDelete: Cascade)
  alternative WorkCenter @relation("WorkCenterIsAlternative", fields: [alternativeId], references: [id], onDelete: Cascade)

  @@id([workCenterId, alternativeId])
  @@index([workCenterId])
  @@index([alternativeId])
  @@map("work_center_alternatives")
}

enum PermissionScope {
  ALL
  CREATED_BY_ME
  UPDATED_BY_ME
  ASSIGNED_TO_ME
}

// Privilege Matrix - Roles and permissions per tenant
model Role {
  id        String    @id @default(uuid()) @db.Uuid
  name      String    @db.VarChar(255)
  code      String    @unique @db.VarChar(100)
  isCustom  Boolean?  @map("is_custom")
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamp(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamp(6)
  createdBy String?   @map("created_by") @db.Uuid
  updatedBy String?   @map("updated_by") @db.Uuid

  rolePermissions RolePermission[]

  @@index([code])
  @@map("roles")
}

model Permission {
  id        String          @id @default(uuid()) @db.Uuid
  resource  String          @db.VarChar(100)
  action    String          @db.VarChar(50)
  scope     PermissionScope @default(ALL)
  createdAt DateTime        @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt DateTime        @updatedAt @map("updated_at") @db.Timestamp(6)
  createdBy String?         @map("created_by") @db.Uuid
  updatedBy String?         @map("updated_by") @db.Uuid

  rolePermissions RolePermission[]

  @@unique([resource, action, scope], name: "resource_action_scope")
  @@index([resource])
  @@map("permissions")
}

model RolePermission {
  roleId       String @map("role_id") @db.Uuid
  permissionId String @map("permission_id") @db.Uuid

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permission")
}

/// Audit Log - System activity tracking (tenant-specific)
model AuditLog {
  id               String   @id @default(uuid()) @db.Uuid
  userId           String?  @map("user_id") @db.Uuid // FK to users.id in public schema (no relation due to cross-schema)
  userEmail        String?  @map("user_email") @db.VarChar(255)
  userName         String?  @map("user_name") @db.VarChar(255)
  module           String   @db.VarChar(100) // e.g., "User Management", "Inventory"
  action           String   @db.VarChar(50) // "Create", "Update", "Delete", "View"
  entityType       String?  @map("entity_type") @db.VarChar(100) // e.g., "User", "Warehouse"
  entityId         String?  @map("entity_id") @db.Uuid
  affectedRecordId String?  @map("affected_record_id") @db.VarChar(255)
  oldValues        Json?    @map("old_values") @db.JsonB
  newValues        Json?    @map("new_values") @db.JsonB
  metadata         Json?    @db.JsonB // Additional context (request_id, session_id, etc.)
  ipAddress        String?  @map("ip_address") @db.VarChar(45)
  userAgent        String?  @map("user_agent") @db.Text
  timestamp        DateTime @db.Timestamp(6)
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamp(6)

  @@index([userId])
  @@index([module])
  @@index([action])
  @@index([timestamp])
  @@index([entityType, entityId])
  @@index([timestamp, module])
  @@map("audit_logs")
}

/// AI Chat Thread - Tenant-scoped saved conversation container
model AiChatThread {
  id              String    @id @default(uuid()) @db.Uuid
  createdBySub    String    @map("created_by_sub") @db.VarChar(255)
  createdByUserId String?   @map("created_by_user_id") @db.Uuid // public.users.id snapshot, no cross-schema FK
  createdByEmail  String?   @map("created_by_email") @db.VarChar(255)
  createdByName   String?   @map("created_by_name") @db.VarChar(255)
  title           String?   @db.VarChar(255)
  lastMessageAt   DateTime? @map("last_message_at") @db.Timestamp(6)
  metadata        Json?     @db.JsonB
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamp(6)
  deletedAt       DateTime? @map("deleted_at") @db.Timestamp(6)

  messages AiChatMessage[]

  @@index([createdBySub])
  @@index([lastMessageAt])
  @@map("ai_chat_threads")
}

/// AI Chat Message - Tenant-scoped saved user/assistant message
model AiChatMessage {
  id            String   @id @default(uuid()) @db.Uuid
  threadId      String   @map("thread_id") @db.Uuid
  sequence      Int
  role          String   @db.VarChar(20)
  content       String   @db.Text
  visualization Json?    @db.JsonB
  inputTokens   Int?     @map("input_tokens")
  outputTokens  Int?     @map("output_tokens")
  metadata      Json?    @db.JsonB
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamp(6)

  thread AiChatThread @relation(fields: [threadId], references: [id], onDelete: Cascade)

  @@index([threadId, sequence])
  @@map("ai_chat_messages")
}

/// User Token Quota - Tenant-scoped per-user AI token allocation/usage tracking
model UserTokenQuota {
  id              String    @id @default(uuid()) @db.Uuid
  userId          String    @unique @map("user_id") @db.Uuid // public.users.id snapshot, no cross-schema FK
  totalAllocated  BigInt    @default(0) @map("total_allocated") // total tokens allocated for the current period
  availableAmount BigInt    @default(0) @map("available_amount") // tokens currently remaining to consume
  usedAmount      BigInt    @default(0) @map("used_amount") // cumulative tokens consumed in the current period
  periodStartAt   DateTime? @map("period_start_at") @db.Timestamp(6)
  periodEndAt     DateTime? @map("period_end_at") @db.Timestamp(6)
  lastResetAt     DateTime? @map("last_reset_at") @db.Timestamp(6)
  lastConsumedAt  DateTime? @map("last_consumed_at") @db.Timestamp(6)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt       DateTime  @default(now()) @map("updated_at") @db.Timestamp(6)


  @@index([userId])
  @@map("user_token_quotas")
}

/// File - Tenant-scoped uploaded file record
model File {
  id          String   @id @default(uuid()) @db.Uuid
  filename    String   @db.VarChar(500)
  size        Int
  type        String   @db.VarChar(100)
  domain      String   @db.VarChar(255)
  storagePath String   @map("storage_path") @db.VarChar(1000)
  url         String?  @db.VarChar(1000)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  createdBy   String?  @map("created_by") @db.Uuid

  templates  Template[]  @relation("TemplateFile")
  quotations Quotation[] @relation("QuotationFile")

  @@index([domain])
  @@map("files")
}

// BOM - Operations
model Operations {
  id                String    @id @default(uuid()) @db.Uuid
  bomId             String    @map("bom_id") @db.Uuid
  operationName     String    @db.VarChar(255)
  workCenterId      String    @db.Uuid
  estimatedDuration Int       @default(0)
  instructions      String?   @db.VarChar(1000)
  operationTypeId   String    @map("operation_type_id") @db.Uuid // References master_data.id (OPERATION_TYPE: Independent, etc.)
  allowedEmployees  String[]  @default([]) @map("allowed_employees") @db.Uuid
  customElements    Json?     @map("custom_elements") @db.JsonB
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.Timestamp(6)
  createdBy         String?   @map("created_by") @db.Uuid
  updatedBy         String?   @map("updated_by") @db.Uuid
  deletedAt         DateTime? @map("deleted_at") @db.Timestamp(6)

  bom           Bom                   @relation(fields: [bomId], references: [id])
  workCenter    WorkCenter            @relation(fields: [workCenterId], references: [id], onDelete: Restrict)
  operationType MasterData            @relation("OperationType", fields: [operationTypeId], references: [id])
  dependencies  OperationDependency[] @relation("OperationDependencies") // operations this one depends on
  dependedOnBy  OperationDependency[] @relation("DependedOnBy") // operations that depend on this one
  bomOrderEntry BomOperationOrder? // 1:1 ordering entry for this operation within its BOM
  workOrders    WorkOrder[]           @relation("WorkOrderOperation")

  @@index([bomId])
  @@index([workCenterId])
  @@index([operationTypeId])
  @@map("operations")
}

// Operation dependencies - join table with FK constraints for referential integrity
model OperationDependency {
  id          String   @id @default(uuid()) @db.Uuid
  operationId String   @map("operation_id") @db.Uuid // The dependent operation (has the dependency)
  dependsOnId String   @map("depends_on_id") @db.Uuid // The operation it depends on
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamp(6)

  operation Operations @relation("OperationDependencies", fields: [operationId], references: [id], onDelete: Cascade)
  dependsOn Operations @relation("DependedOnBy", fields: [dependsOnId], references: [id], onDelete: Cascade)

  @@unique([operationId, dependsOnId])
  @@index([operationId])
  @@index([dependsOnId])
  @@map("operation_dependencies")
}

/// PurchaseOrder - A purchase order sent to a vendor for inventory items
model PurchaseOrder {
  id                    String    @id @default(uuid()) @db.Uuid
  referenceNo           String    @unique @map("reference_no") @db.VarChar(50)
  vendorId              String?   @map("vendor_id") @db.Uuid
  vendorName            String?   @map("vendor_name") @db.VarChar(255)
  organisationId        String?   @map("organisation_id") @db.Uuid // FK → Organisation
  warehouseId           String?   @map("warehouse_id") @db.Uuid
  scheduledDeliveryDate DateTime? @map("scheduled_delivery_date") @db.Timestamp(6)
  status                String    @default("Draft") @map("status") @db.VarChar(50) // Draft, Pending Receipt, Partially Received, Partially Received - Closed, Goods Received
  customElements        Json?     @map("custom_elements") @db.JsonB
  integrationBillId       String?   @map("integration_bill_id") @db.VarChar(50)
  integrationBillStatus   String?   @map("integration_bill_status") @db.VarChar(20) // pending | created | failed
  integrationReceiptId    String?   @map("integration_receipt_id") @db.VarChar(50)
  integrationSyncedAt     DateTime? @map("integration_synced_at") @db.Timestamp(6)
  billCreated             Boolean   @default(false) @map("bill_created")
  billCreatedAt           DateTime? @map("bill_created_at") @db.Timestamp(6)
  createdBy             String?   @map("created_by") @db.Uuid
  updatedBy             String?   @map("updated_by") @db.Uuid
  sentAt                DateTime? @map("sent_at") @db.Timestamp(6)
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt             DateTime  @updatedAt @map("updated_at") @db.Timestamp(6)

  lines            PurchaseOrderLine[]
  grns             GoodsReceivedNote[]
  moComponents     MOComponent[]       @relation("MOComponentPO")
  organisation_rel Organisation?       @relation(fields: [organisationId], references: [id], onDelete: SetNull)

  @@index([vendorId])
  @@index([organisationId])
  @@index([warehouseId])
  @@index([status])
  @@map("purchase_orders")
}

/// PurchaseOrderLine - Individual item lines within a purchase order
model PurchaseOrderLine {
  id               String   @id @default(uuid()) @db.Uuid
  purchaseOrderId  String   @map("purchase_order_id") @db.Uuid
  itemId           String   @map("item_id") @db.Uuid
  itemName         String?  @map("item_name") @db.VarChar(255)
  orderedQuantity  Decimal  @map("ordered_quantity") @db.Decimal(10, 2)
  receivedQuantity Decimal  @default(0) @map("received_quantity") @db.Decimal(10, 2)
  unitPrice        Decimal  @map("unit_price") @db.Decimal(18, 4)
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamp(6)

  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  grnLines      GRNLine[]

  @@index([purchaseOrderId])
  @@index([itemId])
  @@map("purchase_order_lines")
}

/// GoodsReceivedNote - Records the receipt of goods against a Purchase Order
model GoodsReceivedNote {
  id                    String    @id @default(uuid()) @db.Uuid
  referenceNo           String    @unique @map("reference_no") @db.VarChar(50)
  purchaseOrderId       String    @map("purchase_order_id") @db.Uuid
  vendorId              String    @map("vendor_id") @db.Uuid
  vendorName            String?   @map("vendor_name") @db.VarChar(255)
  warehouseId           String    @map("warehouse_id") @db.Uuid
  warehouseSection      String?   @map("warehouse_section") @db.VarChar(100)
  warehouseShelf        String?   @map("warehouse_shelf") @db.VarChar(100)
  scheduledDeliveryDate DateTime? @map("scheduled_delivery_date") @db.Timestamp(6)
  status                String    @default("Draft") @map("status") @db.VarChar(50) // Draft, Partially Received, Goods Received
  isPartiallyClosed     Boolean   @default(false) @map("is_partially_closed")
  note                  String?   @map("note") @db.Text
  customElements        Json?     @map("custom_elements") @db.JsonB
  createdBy             String    @map("created_by") @db.Uuid
  updatedBy             String?   @map("updated_by") @db.Uuid
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt             DateTime  @updatedAt @map("updated_at") @db.Timestamp(6)

  purchaseOrder    PurchaseOrder @relation(fields: [purchaseOrderId], references: [id])
  warehouse        Warehouse     @relation(fields: [warehouseId], references: [id])
  organisation_rel Organisation  @relation(fields: [vendorId], references: [id], onDelete: Restrict)
  lines            GRNLine[]

  @@index([purchaseOrderId])
  @@index([vendorId])
  @@index([warehouseId])
  @@index([status])
  @@map("goods_received_notes")
}

/// GRNLine - Individual item lines within a GRN
model GRNLine {
  id                  String   @id @default(uuid()) @db.Uuid
  grnId               String   @map("grn_id") @db.Uuid
  purchaseOrderLineId String   @map("purchase_order_line_id") @db.Uuid
  itemId              String   @map("item_id") @db.Uuid
  itemName            String?  @map("item_name") @db.VarChar(255)
  orderedQuantity     Decimal  @map("ordered_quantity") @db.Decimal(10, 2)
  receivedQuantity    Decimal  @default(0) @map("received_quantity") @db.Decimal(10, 2)
  unitPrice           Decimal  @map("unit_price") @db.Decimal(18, 4)
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt           DateTime @updatedAt @map("updated_at") @db.Timestamp(6)

  grn               GoodsReceivedNote @relation(fields: [grnId], references: [id], onDelete: Cascade)
  purchaseOrderLine PurchaseOrderLine @relation(fields: [purchaseOrderLineId], references: [id])

  @@index([grnId])
  @@index([purchaseOrderLineId])
  @@index([itemId])
  @@map("grn_lines")
}

/// Template - Document/report templates with type and status from master data
model Template {
  id               String    @id @default(uuid()) @db.Uuid
  templateName     String    @map("template_name") @db.VarChar(255)
  templateTypeId   String    @map("template_type_id") @db.Uuid // FK to master_data (TEMPLATE_TYPE)
  templateCode     String    @map("template_code") @db.VarChar(100)
  description      String?   @db.Text
  templateStatusId String    @map("template_status_id") @db.Uuid // FK to master_data (TEMPLATE_STATUS)
  templateFileId   String?   @map("template_file_id") @db.Uuid
  customElements   Json?     @map("custom_elements") @db.JsonB
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamp(6)
  createdBy        String?   @map("created_by") @db.Uuid
  updatedBy        String?   @map("updated_by") @db.Uuid
  deletedAt        DateTime? @map("deleted_at") @db.Timestamp(6)

  templateType_rel   MasterData @relation("TemplateType", fields: [templateTypeId], references: [id], onDelete: Restrict)
  templateStatus_rel MasterData @relation("TemplateStatus", fields: [templateStatusId], references: [id], onDelete: Restrict)
  templateFile_rel   File?      @relation("TemplateFile", fields: [templateFileId], references: [id], onDelete: SetNull)

  @@index([templateTypeId])
  @@index([templateStatusId])
  @@index([deletedAt])
  @@map("templates")
}

// BomOperationOrder - Stores the user-defined display order for operations within a BOM.
model BomOperationOrder {
  id          String   @id @default(uuid()) @db.Uuid
  bomId       String   @map("bom_id") @db.Uuid
  operationId String   @unique @map("operation_id") @db.Uuid // 1:1 with Operations
  position    Int      @default(0)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamp(6)

  bom       Bom        @relation(fields: [bomId], references: [id], onDelete: Cascade)
  operation Operations @relation(fields: [operationId], references: [id], onDelete: Cascade)

  @@index([bomId])
  @@map("bom_operation_orders")
}

/// WorkOrder - One operation execution record per BOM operation, per ManufacturingOrder
model WorkOrder {
  id                String    @id @default(uuid()) @db.Uuid
  moId              String    @map("mo_id") @db.Uuid
  operationId       String    @map("operation_id") @db.Uuid
  workCenterId      String    @map("work_center_id") @db.Uuid
  quantity          Decimal   @db.Decimal(12, 4)
  unitsDone         Decimal   @default(0) @map("units_done") @db.Decimal(12, 4) // units completed by operator
  expectedDuration  Int       @map("expected_duration") // minutes (from BOM operation)
  realDuration      Int?      @map("real_duration") // minutes (sum of time logs)
  scheduledStart    DateTime? @map("scheduled_start") @db.Timestamp(6)
  scheduledEnd      DateTime? @map("scheduled_end") @db.Timestamp(6)
  actualStart       DateTime? @map("actual_start") @db.Timestamp(6)
  actualEnd         DateTime? @map("actual_end") @db.Timestamp(6)
  assignedOperators String[]  @default([]) @map("assigned_operators") // user UUIDs (cross-schema)
  customElements    Json?     @map("custom_elements") @db.JsonB
  statusId          String    @map("status_id") @db.Uuid // FK → MasterData (WORK_ORDER_STATUS)
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.Timestamp(6)
  createdBy         String    @map("created_by") @db.Uuid
  updatedBy         String?   @map("updated_by") @db.Uuid

  mo         ManufacturingOrder @relation(fields: [moId], references: [id], onDelete: Cascade)
  operation  Operations         @relation("WorkOrderOperation", fields: [operationId], references: [id], onDelete: Restrict)
  workCenter WorkCenter         @relation("WorkOrderWorkCenter", fields: [workCenterId], references: [id], onDelete: Restrict)
  status_rel MasterData         @relation("WorkOrderStatus", fields: [statusId], references: [id], onDelete: Restrict)
  timeLogs   WorkOrderTimeLog[]

  @@index([moId])
  @@index([operationId])
  @@index([workCenterId])
  @@index([statusId])
  @@map("work_orders")
}

/// MOComponent - Snapshot of BOM components at MO creation time
/// Decoupled from BOM so BOM edits don't affect in-flight MOs
model MOComponent {
  id              String   @id @default(uuid()) @db.Uuid
  moId            String   @map("mo_id") @db.Uuid
  itemId          String?  @map("item_id") @db.Uuid
  productId       String?  @map("product_id") @db.Uuid
  componentType   String   @map("component_type") @db.VarChar(10) // 'item' | 'product'
  requiredQty     Decimal  @map("required_qty") @db.Decimal(12, 4)
  reservedQty     Decimal  @default(0) @map("reserved_qty") @db.Decimal(12, 4) // qty actually deducted from stock; pending = requiredQty - reservedQty
  consumedQty     Decimal  @default(0) @map("consumed_qty") @db.Decimal(12, 4)
  availabilityId  String   @map("availability_id") @db.Uuid // FK → MasterData (MO_COMPONENT_STATUS)
  purchaseOrderId String?  @map("purchase_order_id") @db.Uuid // FK → PurchaseOrder (optional, linked when PO raised for this component)
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamp(6)

  mo               ManufacturingOrder @relation(fields: [moId], references: [id], onDelete: Cascade)
  item             Item?              @relation("MOComponentItem", fields: [itemId], references: [id], onDelete: SetNull)
  product          Product?           @relation("MOComponentProduct", fields: [productId], references: [id], onDelete: SetNull)
  availability_rel MasterData         @relation("MOComponentAvailability", fields: [availabilityId], references: [id], onDelete: Restrict)
  purchaseOrder    PurchaseOrder?     @relation("MOComponentPO", fields: [purchaseOrderId], references: [id], onDelete: SetNull)

  @@index([moId])
  @@index([itemId])
  @@index([productId])
  @@index([availabilityId])
  @@index([purchaseOrderId])
  @@map("mo_components")
}

/// WorkOrderTimeLog - One row per start/stop pair per operator on a WorkOrder
model WorkOrderTimeLog {
  id              String    @id @default(uuid()) @db.Uuid
  workOrderId     String    @map("work_order_id") @db.Uuid
  operatorId      String    @map("operator_id") @db.Uuid // public.users.id (cross-schema, no FK)
  startedAt       DateTime  @map("started_at") @db.Timestamp(6)
  endedAt         DateTime? @map("ended_at") @db.Timestamp(6)
  durationMinutes Int?      @map("duration_minutes") // computed on stop
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamp(6)

  workOrder WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)

  @@index([workOrderId])
  @@index([operatorId])
  @@map("work_order_time_logs")
}

/// FinishedGoodsTransfer - Records Send to Warehouse transfers when MO reaches Done
model FinishedGoodsTransfer {
  id            String   @id @default(uuid()) @db.Uuid
  moId          String   @map("mo_id") @db.Uuid
  warehouseId   String   @map("warehouse_id") @db.Uuid
  quantity      Decimal  @db.Decimal(12, 4)
  transferredBy String   @map("transferred_by") @db.Uuid // public.users.id (cross-schema)
  transferredAt DateTime @map("transferred_at") @db.Timestamp(6)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamp(6)

  mo        ManufacturingOrder @relation(fields: [moId], references: [id], onDelete: Restrict)
  warehouse Warehouse          @relation("FinishedGoodsWarehouse", fields: [warehouseId], references: [id], onDelete: Restrict)

  @@index([moId])
  @@index([warehouseId])
  @@map("finished_goods_transfers")
}

/// Quotation - Price proposal for a contact (CRM/Sales domain)
/// Dual-status system:
/// - stageId: Progress stage shown in frontend stepper (Quotation → Quotation Sent → Sales Order)
///           Controls workflow process and what actions user can perform
/// - statusId: Main quotation status shown in grid (Draft, Quotation Sent, Closed Lost, etc.)
///            Tracks business outcome independent from stage
///
/// Important: These two statuses are INDEPENDENT
/// Example: stageId=QUOTATION_SENT + statusId=CLOSED_LOST means
///          "We sent it to the customer, but they rejected it"
model Quotation {
  id                  String    @id @default(uuid()) @db.Uuid
  quotationId         String    @unique @map("quotation_id") @db.VarChar(20) // Unique sequential ID (Q00001, Q00002, etc.)
  salesOrderId        String?   @unique @map("sales_order_id") @db.VarChar(20) // Sales order ID set on confirmation (S00001, S00002, etc.)
  contactId           String?   @map("contact_id") @db.Uuid
  organisationId      String?   @map("organisation_id") @db.Uuid // FK → Organisation
  stageId             String    @map("stage_id") @db.Uuid // STAGE: QUOTATION|QUOTATION_SENT|SALES_ORDER - Frontend stepper progress
  statusId            String    @map("status_id") @db.Uuid // STATUS: DRAFT|QUOTATION_SENT|CLOSED_LOST|etc - Main status column
  quoteType           String    @map("quote_type") @db.VarChar(30) // 'System Generated' | 'Manual'
  expirationDate      DateTime? @map("expiration_date") @db.Date // When quote expires (optional in DRAFT status)
  paymentTermsId      String?   @map("payment_terms_id") @db.Uuid // FK to MasterData PAYMENT_TERMS (optional in DRAFT status)
  totalAmount         Decimal   @default(0) @map("total_amount") @db.Decimal(18, 2) // Cached total for performance (sum of line items)
  taxPercentage       Decimal?  @map("tax_percentage") @db.Decimal(5, 2)  // GST % snapshot at time of save (null = no tax)
  taxAmount           Decimal?  @map("tax_amount") @db.Decimal(18, 2)     // totalAmount × taxPercentage / 100
  grandTotal          Decimal   @default(0) @map("grand_total") @db.Decimal(18, 2) // totalAmount + taxAmount
  quoteFileId         String?   @map("quote_file_id") @db.Uuid // FK to File model: System-generated PDF or manual upload
  salesPersonId       String    @map("sales_person_id") @db.Uuid // FK to users.id (public schema - cross-tenant reference)
  sentAt              DateTime? @map("sent_at") @db.Timestamp(6) // Set when transitioned to SENT workflow
  lostAt              DateTime? @map("lost_at") @db.Timestamp(6) // Set when quotationStatus → CLOSED_LOST
  salesOrderCreatedAt DateTime? @map("sales_order_created_at") @db.Timestamp(6) // Set when quotation confirmed as Sales Order
  customElements      Json?     @map("custom_elements") @db.JsonB
  integrationInvoiceId     String?   @map("integration_invoice_id") @db.VarChar(50)
  integrationInvoiceStatus String?   @map("integration_invoice_status") @db.VarChar(20) // pending | created | failed
  integrationSyncedAt      DateTime? @map("integration_synced_at") @db.Timestamp(6)
  createdAt              DateTime  @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt           DateTime  @updatedAt @map("updated_at") @db.Timestamp(6)
  createdBy           String    @map("created_by") @db.Uuid
  updatedBy           String?   @map("updated_by") @db.Uuid
  deletedAt           DateTime? @map("deleted_at") @db.Timestamp(6) // Soft delete: set when quotation deleted (only in DRAFT workflow)

  contact_rel         Contact?             @relation("QuotationContact", fields: [contactId], references: [id], onDelete: Restrict)
  organisation_rel    Organisation?        @relation("QuotationOrganisation", fields: [organisationId], references: [id], onDelete: SetNull)
  stage_rel           MasterData           @relation("QuotationStage", fields: [stageId], references: [id], onDelete: Restrict) // Frontend stepper: QUOTATION|QUOTATION_SENT|SALES_ORDER
  status_rel          MasterData           @relation("QuotationStatus", fields: [statusId], references: [id], onDelete: Restrict) // Main status: DRAFT|QUOTATION_SENT|CLOSED_LOST|etc
  paymentTerms_rel    MasterData?          @relation("QuotationPaymentTerms", fields: [paymentTermsId], references: [id], onDelete: Restrict) // Payment terms from master data (optional in DRAFT status)
  quoteFile_rel       File?                @relation("QuotationFile", fields: [quoteFileId], references: [id], onDelete: SetNull) // Attached PDF or uploaded file
  manufacturingOrders ManufacturingOrder[] @relation("QuotationMOs") // one MO per manufacturable line item
  lineItems           QuotationLineItem[]

  @@index([contactId])
  @@index([organisationId])
  @@index([stageId])
  @@index([statusId])
  @@index([paymentTermsId])
  @@index([salesPersonId])
  @@index([salesOrderId])
  @@index([expirationDate])
  @@index([salesOrderCreatedAt])
  @@index([createdAt])
  @@index([deletedAt])
  @@map("quotations")
}

/// QuotationLineItem - Individual product line in a quotation
model QuotationLineItem {
  id                   String   @id @default(uuid()) @db.Uuid
  quotationId          String   @map("quotation_id") @db.Uuid
  productId            String   @map("product_id") @db.Uuid // FK to Product (manufacturing product definition)
  quantity             Decimal  @db.Decimal(18, 4)
  unitPrice            Decimal  @map("unit_price") @db.Decimal(18, 4) // Price from product master at time of quotation
  salesPrice           Decimal  @map("sales_price") @db.Decimal(18, 4) // Negotiated price for this quotation
  lineAmount           Decimal  @map("line_amount") @db.Decimal(18, 2) // quantity × salesPrice (stored for performance)
  sortOrder            Int      @default(0) @map("sort_order")
  pendingManufacturing Boolean  @default(false) @map("pending_manufacturing") // True when confirmed stock was insufficient — awaiting MO or procurement
  createdAt            DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt            DateTime @updatedAt @map("updated_at") @db.Timestamp(6)

  quotation_rel Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  product_rel   Product   @relation("QuotationLineItem", fields: [productId], references: [id], onDelete: Restrict)

  @@index([quotationId])
  @@index([productId])
  @@map("quotation_line_items")
}

/// Integration - stores connection configurations for external systems (Acumatica, MaXXlink, MYOB, etc.)
model Integration {
  id               String    @id @default(uuid()) @db.Uuid
  integrationName  String    @map("integration_name") @db.VarChar(255)
  integrationType  String    @map("integration_type") @db.VarChar(100) // 'Acumatica' | 'MaXXlink' | 'MYOB'
  companyName      String?   @map("company_name") @db.VarChar(255)
  baseUrl          String    @map("base_url") @db.VarChar(500)
  apiKey           String?   @map("api_key") @db.VarChar(500)
  tenantId         String?   @map("tenant_id") @db.VarChar(255)
  username         String?   @db.VarChar(255)
  password         String?   @db.VarChar(500)          // encrypted at rest
  connectionStatusId String    @map("connection_status_id") @db.Uuid
  lastTestedAt       DateTime? @map("last_tested_at") @db.Timestamp(6)
  deactivatedAt      DateTime? @map("deactivated_at") @db.Timestamp(6) // set when connectionStatus flips to Inactive; cleared on reactivation. Basis for reactivation-staleness detection (compare against integration_entity_sync.syncedAt).
  connectionBrokenAt     DateTime? @map("connection_broken_at") @db.Timestamp(6) // set when a live signal from the external system (e.g. revoked OAuth grant, 403) proves the connection is dead; cleared on next successful auth
  connectionBrokenReason String?   @map("connection_broken_reason") @db.VarChar(500)
  sessionCookie      String?   @map("session_cookie") @db.Text            // active Acumatica session cookie; maintained by AcumaticaAuthCronService
  cookieExpiresAt    DateTime? @map("cookie_expires_at") @db.Timestamp(6) // parsed from Set-Cookie expires; used to schedule next refresh
  sessionLastUsedAt  DateTime? @map("session_last_used_at") @db.Timestamp(6) // stamped on every authenticated Acumatica request; drives idle logout in the refresh cron
  externalFieldSchema Json?    @map("external_field_schema") @db.JsonB     // per-entity field names probed from the external system; populated on save. Shape: ExternalFieldSchema
  createdBy          String?   @map("created_by") @db.Uuid
  updatedBy          String?   @map("updated_by") @db.Uuid
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt          DateTime  @updatedAt @map("updated_at") @db.Timestamp(6)
  deletedAt          DateTime? @map("deleted_at") @db.Timestamp(6)

  connectionStatus_rel MasterData @relation("IntegrationConnectionStatus", fields: [connectionStatusId], references: [id], onDelete: Restrict)
  templateMappings     TemplateMapping[]

  @@index([integrationType])
  @@index([connectionStatusId])
  // NOTE: partial unique indexes enforced at the DB level (see migration
  // `integration_uniqueness_guard`) — not expressible in Prisma's schema DSL, so not declared here:
  //   - lower(integration_name) WHERE deleted_at IS NULL
  //   - lower(regexp_replace(base_url, '/+$', '')), lower(username) WHERE deleted_at IS NULL
  // Do not run `prisma db push` / `migrate reset` against this model without accounting for that —
  // those reconcile against schema.prisma directly and would silently drop these indexes.
  @@map("integrations")
}

/// ExternalEntityMapping - tracks external system IDs mapped to MRP entity IDs
/// Used by integration endpoints to support idempotent upserts from external systems
model ExternalEntityMapping {
  id         String   @id @default(uuid()) @db.Uuid
  entityType String   @map("entity_type") @db.VarChar(50) // 'item' | 'product' | 'bom'
  entityId   String   @map("entity_id") @db.Uuid
  source     String   @db.VarChar(100) // 'maxxlink' | 'epicor' | 'generic' etc
  externalId String   @map("external_id") @db.VarChar(500) // UUID/ID in the external system
  metadata   Json?    @db.JsonB // sync metadata (revision, timestamps, etc.)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamp(6)

  @@unique([source, entityType, externalId])
  @@index([entityType, entityId, source])
  @@map("external_entity_mappings")
}

/// IntegrationJob - tracks async bulk sync jobs dispatched to Temporal
model IntegrationJob {
  id           String    @id @default(uuid()) @db.Uuid
  workflowId   String    @unique @map("workflow_id") @db.VarChar(255)
  entityType   String    @map("entity_type") @db.VarChar(50) // 'item' | 'product'
  source       String    @db.VarChar(100) // 'maxxlink' | 'epicor' | 'generic'
  status       String    @default("queued") @db.VarChar(50) // 'queued' | 'running' | 'completed' | 'failed'
  totalCount   Int       @map("total_count")
  successCount Int       @default(0) @map("success_count")
  failureCount Int       @default(0) @map("failure_count")
  results      Json?     @db.JsonB // array of UpsertItemResultDto / UpsertProductResultDto
  error        String?   @db.Text
  errorFileUrl String?   @map("error_file_url") @db.Text // SAS URL of the batch sync error report (xlsx)
  createdBy    String    @map("created_by") @db.VarChar(50)
  startedAt    DateTime  @default(now()) @map("started_at") @db.Timestamp(6)
  completedAt  DateTime? @map("completed_at") @db.Timestamp(6)

  @@index([workflowId])
  @@index([status])
  @@index([entityType, source])
  @@map("integration_jobs")
}

/// IntegrationEntitySync - per-entity, per-integration sync state. Generic + multi-integration ready
/// (one row per integration × entity), so an entity can sync to several integrations independently.
/// status: pending | synced | failed_transient | failed_config | failed_data (see BATCH_ENTITY_SYNC.md §6.7).
model IntegrationEntitySync {
  id             String    @id @default(uuid()) @db.Uuid
  integrationId  String    @map("integration_id") @db.Uuid
  entityType     String    @map("entity_type") @db.VarChar(50) // 'item' | 'product'
  entityId       String    @map("entity_id") @db.Uuid
  externalId     String?   @map("external_id") @db.VarChar(100) // e.g. Acumatica InventoryID, set on success
  status         String    @default("pending") @db.VarChar(30)
  lastError      String?   @map("last_error") @db.Text
  lastBatchJobId String?   @map("last_batch_job_id") @db.VarChar(255) // batch job that last touched it
  syncedAt       DateTime? @map("synced_at") @db.Timestamp(6)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamp(6)

  @@unique([integrationId, entityType, entityId])
  @@index([status])
  @@index([entityType, entityId])
  @@map("integration_entity_sync")
}

/// AcumaticaRetryJob - stores failed Acumatica sync operations for exponential-backoff retry (max 3 attempts)
model AcumaticaRetryJob {
  id            String    @id @default(uuid()) @db.Uuid
  integrationId String    @map("integration_id") @db.Uuid
  operationType String    @map("operation_type") @db.VarChar(50) // invoice | bill | item | customer | vendor
  entityId      String    @map("entity_id") @db.Uuid
  payload       Json      @db.JsonB
  retryCount    Int       @default(0) @map("retry_count")
  nextRetryAt   DateTime  @map("next_retry_at") @db.Timestamp(6)
  lastError     String?   @map("last_error") @db.Text
  status        String    @default("pending") @db.VarChar(20) // pending | failed
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamp(6)

  @@index([status, nextRetryAt])
  @@index([integrationId])
  @@map("acumatica_retry_jobs")
}

/// TemplateMapping - named, user-defined mapping of MRP fields to an external integration's fields.
/// Integration-generic: removes hardcoded payload values from the sync builders.
model TemplateMapping {
  id            String    @id @default(uuid()) @db.Uuid
  name          String    @db.VarChar(255)
  integrationId String    @map("integration_id") @db.Uuid
  statusId      String    @map("status_id") @db.Uuid // MasterData STATUS: Active/Inactive
  createdBy     String?   @map("created_by") @db.Uuid
  updatedBy     String?   @map("updated_by") @db.Uuid
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamp(6)
  deletedAt     DateTime? @map("deleted_at") @db.Timestamp(6)

  integration Integration           @relation(fields: [integrationId], references: [id], onDelete: Restrict)
  status_rel  MasterData            @relation("TemplateMappingStatus", fields: [statusId], references: [id], onDelete: Restrict)
  forms       TemplateMappingForm[]

  @@index([integrationId])
  @@index([statusId])
  @@map("template_mappings")
}

/// TemplateMappingForm - one MRP form (e.g. Inventory Item) within a template mapping.
/// entityKey is the generic MRP entity ('item' | 'product' | 'vendor' | 'organisation-customer' |
/// 'contact') resolved from formCode - it, not formCode, is the unique mapping target: a form code
/// can bind to more than one entity key (e.g. ORGANISATION_FORM binds to both 'vendor' and
/// 'organisation-customer' - Vendor and Customer are independent Acumatica targets sharing the same
/// MRP source fields), so uniqueness must be on entityKey, not formCode.
model TemplateMappingForm {
  id                String   @id @default(uuid()) @db.Uuid
  templateMappingId String   @map("template_mapping_id") @db.Uuid
  formCode          String   @map("form_code") @db.VarChar(100)
  entityKey         String   @map("entity_key") @db.VarChar(50)
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamp(6)

  templateMapping TemplateMapping      @relation(fields: [templateMappingId], references: [id], onDelete: Cascade)
  rows            TemplateMappingRow[]

  @@unique([templateMappingId, entityKey])
  @@index([entityKey])
  @@map("template_mapping_forms")
}

/// TemplateMappingRow - one MRP field -> external field pair. Maps fields only, never values.
model TemplateMappingRow {
  id            String  @id @default(uuid()) @db.Uuid
  formId        String  @map("form_id") @db.Uuid
  mrpField      String  @map("mrp_field") @db.VarChar(255) // "partNumber" | "customElements.CurrencyID"
  externalField String  @map("external_field") @db.VarChar(255) // "InventoryID" | "CurrencyID"
  isRequired    Boolean @default(false) @map("is_required")

  form TemplateMappingForm @relation(fields: [formId], references: [id], onDelete: Cascade)

  // One external field is written by exactly one MRP field, but an MRP field MAY map to
  // multiple external fields (one-to-many). So the external field is unique per form, not the MRP field.
  @@unique([formId, externalField])
  @@map("template_mapping_rows")
}


model BulkImportJob {
  id           String   @id @default(uuid()) @db.Uuid
  entityType   String   @map("entity_type") // e.g. 'ORGANISATION_ITEMS'
  status       String   @default("PENDING") // PENDING | PROCESSING | DONE | FAILED
  totalRows    Int      @default(0) @map("total_rows")
  processed    Int      @default(0)
  succeeded    Int      @default(0)
  failed       Int      @default(0)
  inputFileUrl String   @map("input_file_url") @db.Text
  errorFileUrl String?  @map("error_file_url") @db.Text
  requestedBy  String   @map("requested_by") // user email
  metadata     Json?    @db.JsonB // extra context e.g. { organisationId }
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamp(6)

  @@index([status])
  @@index([requestedBy])
  @@map("bulk_import_jobs")
}

model SchemaPool {
  id           String    @id @default(uuid()) @db.Uuid
  schemaName   String    @unique @map("schema_name") @db.VarChar(63)
  /// 'unallocated' | 'allocating' | 'allocated'
  status       String    @default("unallocated") @db.VarChar(20)
  tenantId     String?   @map("tenant_id") @db.Uuid
  isPreSeeded  Boolean   @default(false) @map("is_pre_seeded")
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamp(6)
  allocatedAt  DateTime? @map("allocated_at") @db.Timestamp(6)

  @@index([status])
  @@map("schema_pool")
}

// ============================================
// POLICY DOCUMENTS (public schema — CI Admin managed)
// ============================================

model PolicyDocument {
  id          String   @id @default(uuid()) @db.Uuid
  /// EULA | PRIVACY_POLICY | TERMS_CONDITIONS
  category    String   @db.VarChar(50)
  name        String   @db.VarChar(500)
  description String?  @db.Text
  version     Int      // auto-incremented per category in service layer
  storagePath String   @map("storage_path") @db.VarChar(1000)
  fileUrl     String   @map("file_url") @db.VarChar(1000)
  isCurrent   Boolean  @default(false) @map("is_current") // only one doc per category is current
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamp(6)
  createdBy   String?  @map("created_by") @db.Uuid // references public.users.id

  @@index([category])
  @@index([category, isCurrent])
  @@map("policy_documents")
}
