/// Organisation - Unified entity replacing Vendor (covers both customers and suppliers)
model Organisation {
  id             String    @id @default(uuid()) @db.Uuid
  companyName    String    @map("company_name") @db.VarChar(255)
  companyTypeId  String    @map("company_type_id") @db.Uuid // FK → master_data (ORGANISATION_TYPE: Vendor, Customer, Both)
  email          String    @db.VarChar(255)
  phone          String?   @db.VarChar(50)
  abnNo          String?   @map("abn_no") @db.VarChar(11)
  addressLine01  String    @map("address_line_01") @db.VarChar(255)
  addressLine02  String?   @map("address_line_02") @db.VarChar(255)
  city           String    @db.VarChar(100)
  state          String    @db.VarChar(100)
  postalCode     String    @map("postal_code") @db.VarChar(20)
  countryId      String    @map("country_id") @db.Uuid // FK → master_data (COUNTRY)
  statusId            String    @map("status_id") @db.Uuid // FK → master_data (STATUS)
  customElements      Json?     @map("custom_elements") @db.JsonB
  integrationVendorId   String?   @map("integration_vendor_id") @db.VarChar(50)
  integrationCustomerId String?   @map("integration_customer_id") @db.VarChar(50)
  integrationSyncStatus String?   @map("integration_sync_status") @db.VarChar(20) // pending | synced | failed
  integrationSyncedAt   DateTime? @map("integration_synced_at") @db.Timestamp(6)
  addedDate           DateTime  @default(now()) @map("added_date") @db.Timestamp(6)
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt           DateTime  @updatedAt @map("updated_at") @db.Timestamp(6)
  createdBy           String    @map("created_by") @db.Uuid
  updatedBy           String?   @map("updated_by") @db.Uuid
  deletedAt           DateTime? @map("deleted_at") @db.Timestamp(6)

  companyType_rel MasterData                @relation("OrganisationCompanyType", fields: [companyTypeId], references: [id], onDelete: Restrict)
  country_rel     MasterData                @relation("OrganisationCountry", fields: [countryId], references: [id], onDelete: Restrict)
  status_rel      MasterData                @relation("OrganisationStatus", fields: [statusId], references: [id], onDelete: Restrict)
  contacts           OrganisationContact[]
  purchaseOrders     PurchaseOrder[]
  itemMappings       OrganisationItemMapping[]
  quotations         Quotation[]               @relation("QuotationOrganisation")
  goodsReceivedNotes GoodsReceivedNote[]

  @@unique([email])
  @@index([companyName])
  @@index([email])
  @@index([companyTypeId])
  @@index([statusId])
  @@index([addedDate])
  @@map("organisations")
}

/// Organisation ↔ Contact junction (many-to-many)
model OrganisationContact {
  id             String   @id @default(uuid()) @db.Uuid
  organisationId String   @map("organisation_id") @db.Uuid
  contactId      String   @map("contact_id") @db.Uuid
  isPrimary      Boolean  @default(false) @map("is_primary")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamp(6)

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  contact      Contact      @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@unique([organisationId, contactId])
  @@index([organisationId])
  @@index([contactId])
  @@map("organisation_contacts")
}

/// Organisation Item Mapping - Items supplied by / associated with an organisation
model OrganisationItemMapping {
  id                String   @id @default(uuid()) @db.Uuid
  organisationId    String   @map("organisation_id") @db.Uuid
  itemId            String   @map("item_id") @db.Uuid
  unitPrice         Decimal  @map("unit_price") @db.Decimal(10, 2)
  leadTimeDays      Int      @map("lead_time_days")
  priceLastUpdated  DateTime @default(now()) @map("price_last_updated") @db.Timestamp(6)
  priceValidityDays Int?     @map("price_validity_days")
  isPrimary                Boolean  @default(false) @map("is_primary")
  overrideRemark           String?  @map("override_remark")
  organisationPartNumber   String?  @map("organisation_part_number") @db.VarChar(255)
  note                     String?  @map("note") @db.VarChar(500)
  createdAt                DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt                DateTime @updatedAt @map("updated_at") @db.Timestamp(6)

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  item         Item         @relation("OrganisationItemMappingToItem", fields: [itemId], references: [id], onDelete: Cascade)

  @@unique([organisationId, itemId])
  @@index([organisationId])
  @@index([itemId])
  @@index([isPrimary])
  @@map("organisation_item_mappings")
}

// Vendor Item Mappings - Products supplied by vendors
model VendorItemMapping {
  id                String   @id @default(uuid()) @db.Uuid
  vendorId          String   @map("vendor_id") @db.Uuid
  itemId            String   @map("item_id") @db.Uuid
  unitPrice         Decimal  @map("unit_price") @db.Decimal(10, 2)
  leadTimeDays      Int      @map("lead_time_days")
  priceLastUpdated  DateTime @default(now()) @map("price_last_updated") @db.Timestamp(6)
  priceValidityDays Int?     @map("price_validity_days")
  isPrimary         Boolean  @default(false) @map("is_primary")
  overrideRemark    String?  @map("override_remark")
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamp(6)

  vendor Vendor @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  item   Item   @relation("VendorItemMappingToItem", fields: [itemId], references: [id], onDelete: Cascade)

  @@unique([vendorId, itemId])
  @@index([vendorId])
  @@index([itemId])
  @@index([isPrimary])
  @@map("vendor_item_mappings")
}

/// Contact - CRM Contact management
model Contact {
