// Prisma Schema for Multi-Tenant Architecture
// Schema-Per-Tenant: Each tenant has its own schema
// Shared schema (public) contains tenant metadata
//
// Note: Prisma doesn't natively support dynamic schemas well.
// Models in this schema are used as a template for all tenant schemas.

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-arm64-openssl-3.0.x", "debian-openssl-3.0.x"]
}

generator erd {
  provider     = "prisma-erd-generator"
  output       = "../../../docs/database/erd.svg"
  theme        = "default"
  mmdcPath     = "../../node_modules/.bin"
  disableEmoji = "true"
  disabled     = env("DISABLE_ERD")
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// SHARED SCHEMA (public)
// ============================================
// Contains tenant metadata, users, and system tableKs

model Tenant {
  id                   String    @id @default(uuid()) @db.Uuid
  slug                 String    @unique @db.VarChar(100)
  name                 String    @db.VarChar(255)
  schemaName           String    @unique @map("schema_name") @db.VarChar(63)
  abn                  String?   @db.VarChar(11)
  statusId             String    @map("status_id") @db.Uuid
  tenantSubscriptionId String?   @unique @map("tenant_subscription_id") @db.Uuid
  currentUserCount     Int       @default(0) @map("current_user_count")
  createdAt            DateTime  @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt            DateTime  @updatedAt @map("updated_at") @db.Timestamp(6)
  deletedAt            DateTime? @map("deleted_at") @db.Timestamp(6)

  status              MasterData                @relation("TenantStatus", fields: [statusId], references: [id])
  userTenants         UserTenant[]
  subscriptions       TenantSubscription[]
  currentSubscription TenantSubscription?       @relation("CurrentSubscription", fields: [tenantSubscriptionId], references: [id], onDelete: SetNull)
  apiKeys             ApiKey[]
  supersetDashboards  TenantSupersetDashboard[]
  supersetConnection  TenantSupersetConnection?
  supersetDatasets    TenantSupersetDataset[]
  supersetCharts      TenantSupersetChart[]

  @@index([slug])
  @@index([statusId])
  @@index([tenantSubscriptionId])
  @@map("tenants")
}

model SupersetDashboardTemplate {
  id                  String                    @id @default(uuid()) @db.Uuid
  key                 String                    @unique @db.VarChar(100)
  name                String                    @db.VarChar(255)
  category            String?                   @db.VarChar(100)
  description         String?                   @db.VarChar(500)
  sourceDashboardId   Int?                      @map("source_dashboard_id")
  sourceDashboardUuid String?                   @map("source_dashboard_uuid") @db.Uuid
  isActive            Boolean                   @default(true) @map("is_active")
  createdAt           DateTime                  @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt           DateTime                  @updatedAt @map("updated_at") @db.Timestamp(6)
  tenantDashboards    TenantSupersetDashboard[]

  @@map("superset_dashboard_templates")
}

model TenantSupersetDashboard {
  id                     String    @id @default(uuid()) @db.Uuid
  tenantId               String    @map("tenant_id") @db.Uuid
  templateId             String    @map("template_id") @db.Uuid
  supersetDashboardId    Int?      @map("superset_dashboard_id")
  supersetDashboardUuid  String?   @map("superset_dashboard_uuid") @db.Uuid
  nameOverride           String?   @map("name_override") @db.VarChar(255)
  isDefault              Boolean   @default(false) @map("is_default")
  provisioningStatus     String    @default("pending") @map("provisioning_status") @db.VarChar(50)
  dashboardCustomization Json?     @map("dashboard_customization") @db.JsonB
  customizedAt           DateTime? @map("customized_at") @db.Timestamp(6)
  customizedByUserId     String?   @map("customized_by_user_id") @db.Uuid
  createdAt              DateTime  @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt              DateTime  @updatedAt @map("updated_at") @db.Timestamp(6)

  tenant   Tenant                    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  template SupersetDashboardTemplate @relation(fields: [templateId], references: [id], onDelete: Restrict)
  charts   TenantSupersetChart[]

  @@unique([tenantId, templateId])
  @@index([tenantId])
  @@index([templateId])
  @@index([supersetDashboardId])
  @@index([supersetDashboardUuid])
  @@map("tenant_superset_dashboards")
}

model TenantSupersetConnection {
  id                   String    @id @default(uuid()) @db.Uuid
  tenantId             String    @unique @map("tenant_id") @db.Uuid
  supersetDatabaseId   Int?      @map("superset_database_id")
  supersetDatabaseName String?   @map("superset_database_name") @db.VarChar(255)
  dbRoleName           String?   @map("db_role_name") @db.VarChar(63)
  provisioningStatus   String    @default("pending") @map("provisioning_status") @db.VarChar(50)
  lastSyncedAt         DateTime? @map("last_synced_at") @db.Timestamp(6)
  createdAt            DateTime  @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt            DateTime  @updatedAt @map("updated_at") @db.Timestamp(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([supersetDatabaseId])
  @@map("tenant_superset_connections")
}

model TenantSupersetDataset {
  id                String    @id @default(uuid()) @db.Uuid
  tenantId          String    @map("tenant_id") @db.Uuid
  supersetDatasetId Int       @unique @map("superset_dataset_id")
  supersetDatabaseId Int?     @map("superset_database_id")
  schemaName        String    @map("schema_name") @db.VarChar(63)
  tableName         String    @map("table_name") @db.VarChar(255)
  sourceType        String    @map("source_type") @db.VarChar(20)
  displayName       String    @map("display_name") @db.VarChar(255)
  isChartable       Boolean   @default(true) @map("is_chartable")
  columnMetadata    Json?     @map("column_metadata") @db.JsonB
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.Timestamp(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  charts TenantSupersetChart[]

  @@unique([tenantId, schemaName, tableName, sourceType])
  @@index([tenantId])
  @@index([schemaName, tableName])
  @@index([supersetDatabaseId])
  @@map("tenant_superset_datasets")
}

model TenantSupersetChart {
  id                       String    @id @default(uuid()) @db.Uuid
  tenantId                 String    @map("tenant_id") @db.Uuid
  tenantSupersetDashboardId String   @map("tenant_superset_dashboard_id") @db.Uuid
  tenantSupersetDatasetId  String    @map("tenant_superset_dataset_id") @db.Uuid
  supersetChartId          Int?      @map("superset_chart_id")
  sliceName                String    @map("slice_name") @db.VarChar(255)
  vizType                  String    @map("viz_type") @db.VarChar(100)
  chartConfig              Json      @map("chart_config") @db.JsonB
  layoutConfig             Json      @map("layout_config") @db.JsonB
  isSystem                 Boolean   @default(false) @map("is_system")
  isVisible                Boolean   @default(true) @map("is_visible")
  createdByUserId          String?   @map("created_by_user_id") @db.Uuid
  createdAt                DateTime  @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt                DateTime  @updatedAt @map("updated_at") @db.Timestamp(6)

  tenant              Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  dashboard           TenantSupersetDashboard @relation(fields: [tenantSupersetDashboardId], references: [id], onDelete: Cascade)
  dataset             TenantSupersetDataset   @relation(fields: [tenantSupersetDatasetId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([tenantSupersetDashboardId])
  @@index([tenantSupersetDatasetId])
  @@index([supersetChartId])
  @@map("tenant_superset_charts")
}

model PricingPlan {
  id                   String   @id @default(uuid()) @db.Uuid
  name                 String   @db.VarChar(255)
  description          String?  @db.VarChar(500)
  monthlyAmount        Int?     @map("monthly_amount_cents")
  yearlyAmount         Int?     @map("yearly_amount_cents")
  userCount            Int?     @map("user_count")
  features             Json?    @map("features")
  displayFeatures      Json?    @map("display_features")
  isTrial              Boolean  @default(false) @map("is_trial")
  isActive             Boolean  @default(true) @map("is_active")
  stripePriceIdMonthly String?  @map("stripe_price_id_monthly") @db.VarChar(255)
  stripePriceIdYearly  String?  @map("stripe_price_id_yearly") @db.VarChar(255)
  createdAt            DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt            DateTime @updatedAt @map("updated_at") @db.Timestamp(6)

  subscriptions          TenantSubscription[]
  scheduledSubscriptions TenantSubscription[] @relation("ScheduledPlan")

  @@map("pricing_plans")
}

model TenantSubscription {
  id                    String    @id @default(uuid()) @db.Uuid
  tenantId              String    @map("tenant_id") @db.Uuid
  pricingPlanId         String    @map("pricing_plan_id") @db.Uuid
  statusId              String    @map("status_id") @db.Uuid
  startedAt             DateTime  @map("started_at") @db.Timestamp(6)
  expiresAt             DateTime? @map("expires_at") @db.Timestamp(6)
  reminderSentAt        DateTime? @map("reminder_sent_at") @db.Timestamp(6)
  // Stripe recurring subscription fields
  stripeCustomerId      String?   @map("stripe_customer_id") @db.VarChar(255)
  stripeSubscriptionId  String?   @map("stripe_subscription_id") @db.VarChar(255)
  stripePriceId         String?   @map("stripe_price_id") @db.VarChar(255)
  billingCycle          String?   @map("billing_cycle") @db.VarChar(20) // 'monthly' | 'yearly'
  nextBillingDate       DateTime? @map("next_billing_date") @db.Timestamp(6)
  trialEndsAt           DateTime? @map("trial_ends_at") @db.Timestamp(6)
  stripeInvoiceId       String?   @map("stripe_invoice_id") @db.VarChar(255)
  // Subscription schedule — set when a future plan change is scheduled via Stripe Subscription Schedules
  stripeScheduleId      String?   @map("stripe_schedule_id") @db.VarChar(255)
  // EC19: one-time-use trial token hash — set when token issued, cleared after first use
  trialTokenHash        String?   @map("trial_token_hash") @db.VarChar(64)
  // Scheduled plan change — set when a future plan/cycle change is pending
  scheduledPlanId       String?   @map("scheduled_plan_id") @db.Uuid
  scheduledBillingCycle String?   @map("scheduled_billing_cycle") @db.VarChar(10)
  // Price snapshot — locked at subscription creation so plan edits don't reprice existing subscribers
  lockedMonthlyAmount   Int?      @map("locked_monthly_amount_cents")
  lockedYearlyAmount    Int?      @map("locked_yearly_amount_cents")
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt             DateTime  @updatedAt @map("updated_at") @db.Timestamp(6)

  tenant           Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  pricingPlan      PricingPlan  @relation(fields: [pricingPlanId], references: [id])
  scheduledPlan    PricingPlan? @relation("ScheduledPlan", fields: [scheduledPlanId], references: [id])
  status           MasterData   @relation("TenantSubscriptionStatus", fields: [statusId], references: [id])
  currentForTenant Tenant?      @relation("CurrentSubscription")

  @@index([tenantId])
  @@index([pricingPlanId])
  @@index([statusId])
  @@index([stripeSubscriptionId])
  @@index([stripeCustomerId])
  @@map("tenant_subscriptions")
}

model User {
  id              String    @id @default(uuid()) @db.Uuid
  entraId         String?   @unique @map("entra_id") @db.VarChar(255) // Entra External ID user object ID (sub from id_token)
  upn             String?   @map("upn") @db.VarChar(255) // User Principal Name from Entra (e.g. email format)
  email           String    @unique @db.VarChar(255)
  name            String?   @db.VarChar(255)
  workPhone       String?   @map("work_phone") @db.VarChar(50)
  profileImageUrl String?   @map("profile_image_url") @db.VarChar(500)
  authProvider    String    @default("local") @map("auth_provider") @db.VarChar(20) // 'local' | 'microsoft' | 'google'
  isPrimaryUser   Boolean?  @map("is_primary_user") // true for the first registered user (tenant owner); null for all other users
  isCiAdmin       Boolean   @default(false) @map("is_ci_admin") // true for CI Admin users; false for all regular tenant users.
  mfaEnabled      Boolean   @default(false) @map("mfa_enabled")
  mfaPending      Boolean   @default(false) @map("mfa_pending") // true when MFA enabled at setup but not yet verified
  inviteToken     String?   @map("invite_token") @db.VarChar(500) // hashed tenant user invite token (one-time use)
  statusId        String    @map("status_id") @db.Uuid
  lastSignInAt    DateTime? @map("last_sign_in_at") @db.Timestamp(6)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamp(6)
  deletedAt       DateTime? @map("deleted_at") @db.Timestamp(6)

  status             MasterData          @relation("UserStatus", fields: [statusId], references: [id])
  userTenants        UserTenant[]
  passwordResetCodes PasswordResetCode[]
  apiKeys            ApiKey[]

  @@index([email])
  @@map("users")
}

model UserTenant {
  id             String    @id @default(uuid()) @db.Uuid
  userId         String    @map("user_id") @db.Uuid
  tenantId       String    @map("tenant_id") @db.Uuid
  roleIds        String[]  @default([]) @map("role_ids") // UUIDs from tenant schema roles table (no FK across schemas)
  statusId       String    @map("status_id") @db.Uuid
  invitedAt      DateTime? @map("invited_at") @db.Timestamp(6)
  activatedAt    DateTime? @map("activated_at") @db.Timestamp(6)
  deletedAt      DateTime? @map("deleted_at") @db.Timestamp(6)
  // Work profile — tenant-specific user attributes
  department     String?   @map("department") @db.VarChar(255)
  jobTitle       String?   @map("job_title") @db.VarChar(255)
  workLocation   String?   @map("work_location") @db.VarChar(255)
  managerId      String?   @map("manager_id") @db.Uuid // references public.users.id (no FK across tenant boundary)
  internalNotes  String?   @map("internal_notes") @db.Text
  customElements  Json?    @map("custom_elements") @db.JsonB
  isEulaAccepted  Boolean  @default(false) @map("is_eula_accepted") // true after user accepts the current EULA; reset to false when CI Admin uploads a new EULA version
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamp(6)

  status MasterData @relation("UserTenantStatus", fields: [statusId], references: [id])
  user   User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([userId, tenantId])
  @@index([userId])
  @@index([tenantId])
  @@index([statusId])
  @@map("user_tenants")
}

model PasswordResetCode {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  purpose    String   @default("password-reset") @db.VarChar(32) // 'password-reset' | 'account-verification'
  code       String   @db.Text // hashed OTP or refresh token (mfa-login-session)
  codeExpiry DateTime @map("code_expiry") @db.Timestamp(6)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamp(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, purpose])
  @@map("password_reset_codes")
}

model ApiKey {
  id            String    @id @default(uuid()) @db.Uuid
  keyId         String    @unique @map("key_id") @db.VarChar(32)
  keyHash       String    @map("key_hash") @db.VarChar(255)
  displayPrefix String    @map("display_prefix") @db.VarChar(24)
  name          String    @db.VarChar(255)
  source        String    @default("generic") @map("source") @db.VarChar(100)
  tenantId      String    @map("tenant_id") @db.Uuid
  createdById   String    @map("created_by_id") @db.Uuid
  lastUsedAt    DateTime? @map("last_used_at") @db.Timestamp(6)
  expiresAt     DateTime? @map("expires_at") @db.Timestamp(6)
  revokedAt     DateTime? @map("revoked_at") @db.Timestamp(6)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamp(6)

  tenant    Tenant @relation(fields: [tenantId], references: [id])
  createdBy User   @relation(fields: [createdById], references: [id])

  @@index([keyId])
  @@index([tenantId])
  @@map("api_keys")
}

// Global RAG chunk store — one row per chunk per blob in the `rag-docs`
// Azure Blob container. Shared across all tenants (the user manual is the
// same content for every tenant). Written by the agent-platform's
// rag_sync.py background poller; read by its search_user_manual tool.
// pgvector's `vector` type is not a first-class Prisma type, so we use
// `Unsupported(...)` — Nest/Prisma never touches this table.
model RagChunk {
  id          String                       @id @default(uuid()) @db.Uuid
  blobName    String                       @map("blob_name")
  blobEtag    String                       @map("blob_etag")
  chunkIndex  Int                          @map("chunk_index")
  chunkText   String                       @map("chunk_text")
  contentHash String                       @map("content_hash")
  embedding   Unsupported("vector(1536)")
  metadata    Json                         @default("{}")
  createdAt   DateTime                     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime                     @default(now()) @map("updated_at") @db.Timestamptz(6)

  @@unique([blobName, chunkIndex], map: "rag_chunks_blob_chunk_uq")
  @@index([blobName], map: "rag_chunks_blob_name_idx")
  @@map("rag_chunks")
}

// ============================================
// TENANT SCHEMA MODELS (tenant_template)
// ============================================
// These models define the structure for all tenant schemas.
// They are defined in the "tenant_template" schema for Prisma migrations.
//
// When creating a new tenant:
// 1. Prisma migrations generate SQL from these models
// 2. Migration scripts apply the SQL to each tenant schema (tenant_{slug})
// 3. All tenant schemas have the same structure
//
// To query tenant data, use PrismaService.withTenant() which sets search_path
// to the tenant schema before executing queries.

model ManufacturingOrder {
  id                String    @id @default(uuid()) @db.Uuid
  reference         String    @unique @db.VarChar(20) // WH/MO/00001, auto-generated
  productId         String    @map("product_id") @db.Uuid
  bomId             String?   @map("bom_id") @db.Uuid // optional: non-catalog starts without BOM
  quantity          Decimal   @db.Decimal(12, 4)
  scheduledDate     DateTime? @map("scheduled_date") @db.Timestamp(6)
  statusId          String    @map("status_id") @db.Uuid // FK → MasterData (MO_STATUS)
  componentStatusId String    @map("component_status_id") @db.Uuid // FK → MasterData (MO_COMPONENT_STATUS)
  warehouseId       String?   @map("warehouse_id") @db.Uuid
  quotationId       String?   @map("quotation_id") @db.Uuid // FK → Quotation (set when SO triggers MO creation; one per line item)
  plannedCompletionDate DateTime? @map("planned_completion_date") @db.Timestamp(6) // derived: MAX(scheduledEnd) across active work orders
  confirmedAt       DateTime? @map("confirmed_at") @db.Timestamp(6)
  completedAt       DateTime? @map("completed_at") @db.Timestamp(6)
  cancelledAt       DateTime? @map("cancelled_at") @db.Timestamp(6)
  customElements    Json?     @map("custom_elements") @db.JsonB
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.Timestamp(6)
  deletedAt         DateTime? @map("deleted_at") @db.Timestamp(6)
  createdBy         String    @map("created_by") @db.Uuid
  updatedBy         String?   @map("updated_by") @db.Uuid

  product                Product?                @relation("MOProduct", fields: [productId], references: [id], onDelete: Restrict)
  bom                    Bom?                    @relation(fields: [bomId], references: [id], onDelete: Restrict)
  warehouse              Warehouse?              @relation("MOWarehouse", fields: [warehouseId], references: [id], onDelete: SetNull)
  status_rel             MasterData              @relation("MOStatus", fields: [statusId], references: [id], onDelete: Restrict)
  componentStatus_rel    MasterData              @relation("MOComponentStatus", fields: [componentStatusId], references: [id], onDelete: Restrict)
  quotation_rel          Quotation?              @relation("QuotationMOs", fields: [quotationId], references: [id], onDelete: SetNull)
  components             MOComponent[]
  workOrders             WorkOrder[]
  finishedGoodsTransfers FinishedGoodsTransfer[]

  @@index([statusId])
  @@index([componentStatusId])
  @@index([productId])
  @@index([bomId])
  @@index([warehouseId])
  @@index([quotationId])
  @@map("manufacturing_orders")
}

model Bom {
  id             String    @id @default(uuid()) @db.Uuid
  code           String    @unique @db.VarChar(20) // Auto-generated e.g. BOM-00001
  name           String    @db.VarChar(255)
  productId      String?   @unique @map("product_id") @db.Uuid
  description    String?   @db.Text
  version        String?   @db.VarChar(50)
  locked         Boolean   @default(false) @db.Boolean
  imageUrl       String?   @map("image_url") @db.VarChar(500)
  customElements Json?     @map("custom_elements") @db.JsonB
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamp(6)
  createdBy      String    @map("created_by") @db.Uuid
  updatedBy      String?   @map("updated_by") @db.Uuid
  deletedAt      DateTime? @map("deleted_at") @db.Timestamp(6)

  product             Product?             @relation("BomProduct", fields: [productId], references: [id], onDelete: Restrict)
  manufacturingOrders ManufacturingOrder[]
  operations          Operations[]
  components          BomComponent[]
  operationOrders     BomOperationOrder[]

  @@index([productId])
  @@index([code])
  @@map("boms")
}

/// BomComponent - A component line in a BOM (either an Item or a sub-assembly Product)
model BomComponent {
  id            String   @id @default(uuid()) @db.Uuid
  bomId         String   @map("bom_id") @db.Uuid
  itemId        String?  @map("item_id") @db.Uuid // FK to Item (raw material / goods)
  productId     String?  @map("product_id") @db.Uuid // FK to Product (sub-assembly)
  componentType String   @map("component_type") @db.VarChar(10) // 'item' | 'product'
  quantity      Decimal  @db.Decimal(12, 4)
  unitOfMeasure String?  @map("unit_of_measure") @db.VarChar(50)
  notes         String?  @db.Text
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamp(6)
  createdBy     String   @map("created_by") @db.Uuid
  updatedBy     String?  @map("updated_by") @db.Uuid

  bom     Bom      @relation(fields: [bomId], references: [id], onDelete: Cascade)
  item    Item?    @relation("BomComponentItem", fields: [itemId], references: [id], onDelete: SetNull)
  product Product? @relation("BomComponentProduct", fields: [productId], references: [id], onDelete: SetNull)

  @@index([bomId])
  @@index([itemId])
  @@index([productId])
  @@map("bom_components")
}

model InventoryItem {
  id        String   @id @default(uuid()) @db.Uuid
  sku       String   @unique @db.VarChar(100)
  name      String   @db.VarChar(255)
  quantity  Int      @default(0)
  unit      String?  @db.VarChar(50)
  location  String?  @db.VarChar(255)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamp(6)

  @@map("inventory_items")
}

/// Warehouse - Physical storage location
model Warehouse {
  id               String    @id @default(uuid()) @db.Uuid
  warehouseName    String    @map("warehouse_name") @db.VarChar(255)
  shortName        String    @map("short_name") @db.VarChar(50)
  warehouseManager String?   @map("warehouse_manager") @db.Uuid // FK to users.id in public schema (optional)
  warehouseAddress String?   @map("warehouse_address") @db.Text
  warehouseType    String    @default("none") @map("warehouse_type") @db.VarChar(20) // product | item | both | none
  status           String    @default("active") @db.VarChar(20) // active, inactive
  customElements   Json?     @map("custom_elements") @db.JsonB
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamp(6)
  createdBy        String    @map("created_by") @db.Uuid
  updatedBy        String?   @map("updated_by") @db.Uuid
  deletedAt        DateTime? @map("deleted_at") @db.Timestamp(6)

  sections               WarehouseSection[]
  itemsAsDefault         Item[]                        @relation("DefaultWarehouse")
  itemWarehouses         ItemWarehouse[]
  productsAsDefault      Product[]                     @relation("ProductDefaultWarehouse")
  productAlternatives    ProductAlternativeWarehouse[] @relation("ProductAlternativeWarehouse")
  goodsReceivedNotes     GoodsReceivedNote[]
  manufacturingOrders    ManufacturingOrder[]          @relation("MOWarehouse")
  finishedGoodsTransfers FinishedGoodsTransfer[]       @relation("FinishedGoodsWarehouse")

  @@index([status])
  @@index([warehouseManager])
  @@map("warehouses")
}

/// Item - Inventory item (goods/services) with ROP, pricing, warehouses
model Item {
  id                    String    @id @default(uuid()) @db.Uuid
  itemName              String    @map("item_name") @db.VarChar(255)
  partNumber            String?   @map("part_number") @db.VarChar(100)
  itemType              String    @map("item_type") @db.VarChar(50) // Services, Goods, Combo
  unitCost              Decimal?  @map("unit_cost") @db.Decimal(18, 4)
  unitOfMeasurement     String?   @map("unit_of_measurement") @db.VarChar(50)
  rop                   Int?      @default(0) @map("rop") // Reorder point
  defaultWarehouseId    String?   @map("default_warehouse_id") @db.Uuid
  priceValidityDays     Int?      @map("price_validity_days")
  notes                 String?   @db.Text
  imageUrl              String?   @map("image_url") @db.VarChar(500)
  availableQuantity     Decimal   @default(0) @map("available_quantity") @db.Decimal(10, 2) // Available stock quantity
  forecastedQuantity    Decimal   @default(0) @map("forecasted_quantity") @db.Decimal(10, 2) // Forecasted quantity
  /// STALE — never recalculated after insert; keeps its insert-time default ('Available'). NEVER read or GROUP BY this column. Derive instead: CASE WHEN available_quantity > COALESCE(rop,0) THEN 'Available' WHEN available_quantity < COALESCE(rop,0) THEN 'Below ROP' ELSE 'ROP Reached' END
  ropStatus             String    @default("Available") @map("rop_status") @db.VarChar(20) // Available, Below ROP, ROP Reached
  pricingValidityStatus String    @default("Valid") @map("pricing_validity_status") @db.VarChar(20) // Valid, Out of Date
  status                String    @default("Active") @db.VarChar(20) // Active, Inactive
  customElements        Json?     @map("custom_elements") @db.JsonB
  integrationItemId       String?   @map("integration_item_id") @db.VarChar(50)
  integrationSyncStatus   String?   @map("integration_sync_status") @db.VarChar(20) // pending | synced | failed
  integrationSyncedAt     DateTime? @map("integration_synced_at") @db.Timestamp(6)
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt             DateTime  @updatedAt @map("updated_at") @db.Timestamp(6)
  priceValidFrom        DateTime? @map("price_valid_from") @db.Timestamp(6)
  priceValidTo          DateTime? @map("price_valid_to") @db.Timestamp(6)
  createdBy             String    @map("created_by") @db.Uuid
  updatedBy             String?   @map("updated_by") @db.Uuid
  deletedAt             DateTime? @map("deleted_at") @db.Timestamp(6)

  defaultWarehouse      Warehouse?                @relation("DefaultWarehouse", fields: [defaultWarehouseId], references: [id], onDelete: SetNull)
  alternativeWarehouses ItemWarehouse[]
  vendors               ItemVendor[]
  vendorMappings        VendorItemMapping[]       @relation("VendorItemMappingToItem")
  organisationMappings  OrganisationItemMapping[] @relation("OrganisationItemMappingToItem")
  bomComponents         BomComponent[]            @relation("BomComponentItem")
  moComponents          MOComponent[]             @relation("MOComponentItem")

  @@index([defaultWarehouseId])
  @@index([itemType])
  @@index([partNumber])
  @@index([ropStatus])
  @@index([deletedAt])
  @@map("items")
}

/// ItemWarehouse - Alternative warehouses for an item (many-to-many), with optional section/shelf location
model ItemWarehouse {
  id          String  @id @default(uuid()) @db.Uuid
  itemId      String  @map("item_id") @db.Uuid
  warehouseId String  @map("warehouse_id") @db.Uuid
  sectionId   String? @map("section_id") @db.Uuid
  shelfId     String? @map("shelf_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamp(6)

  item      Item              @relation(fields: [itemId], references: [id], onDelete: Cascade)
  warehouse Warehouse         @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  section   WarehouseSection? @relation(fields: [sectionId], references: [id], onDelete: SetNull)
  shelf     WarehouseShelf?   @relation(fields: [shelfId], references: [id], onDelete: SetNull)

  @@unique([itemId, warehouseId])
  @@index([itemId])
  @@index([warehouseId])
  @@index([sectionId])
  @@index([shelfId])
  @@map("item_warehouses")
}

/// ItemVendor - Vendor assignment for an item (lead time, unit price)
model ItemVendor {
  id               String    @id @default(uuid()) @db.Uuid
  itemId           String    @map("item_id") @db.Uuid
  vendorId         String    @map("vendor_id") @db.Uuid
  vendorName       String?   @map("vendor_name") @db.VarChar(255)
  leadTimeDays     Int?      @map("lead_time_days")
  unitPrice        Decimal?  @map("unit_price") @db.Decimal(18, 4)
  priceLastUpdated DateTime? @map("price_last_updated") @db.Timestamp(6)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamp(6)

  item Item @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@index([itemId])
  @@index([vendorId])
  @@map("item_vendors")
}

/// WarehouseSection - Logical section within a warehouse
model WarehouseSection {
  id          String    @id @default(uuid()) @db.Uuid
  warehouseId String    @map("warehouse_id") @db.Uuid
  sectionName String    @map("section_name") @db.VarChar(255)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamp(6)
  deletedAt   DateTime? @map("deleted_at") @db.Timestamp(6)

  warehouse      Warehouse        @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  shelves        WarehouseShelf[]
  itemWarehouses ItemWarehouse[]

  @@index([warehouseId])
  @@map("warehouse_sections")
}

/// WarehouseShelf - Shelf within a warehouse section
model WarehouseShelf {
  id        String    @id @default(uuid()) @db.Uuid
  sectionId String    @map("section_id") @db.Uuid
  shelfName String    @map("shelf_name") @db.VarChar(255)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamp(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamp(6)

  section        WarehouseSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  itemWarehouses ItemWarehouse[]

  @@index([sectionId])
  @@map("warehouse_shelves")
}

model FormConfiguration {
  id         String    @id @default(uuid()) @db.Uuid
  formName   String    @map("form_name") @db.VarChar(255)
  formCode   String    @unique @map("form_code") @db.VarChar(100)
  formSchema Json      @map("form_schema")
  statusId   String    @map("status_id") @db.Uuid // References master_data.id (FORM_CONFIGURATION_STATUS: Active/Inactive)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt  DateTime? @updatedAt @map("updated_at") @db.Timestamp(6)
  updatedBy  String?   @map("updated_by") @db.VarChar(255)

  status MasterData @relation("FormConfigStatus", fields: [statusId], references: [id])

  @@index([formCode])
  @@index([statusId])
  @@map("form_configurations")
}

/// GeneralConfiguration - Singleton row per tenant storing all general app settings as JSONB
model GeneralConfiguration {
  id        String   @id @default(uuid()) @db.Uuid
  settings  Json     @map("settings") @db.JsonB
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamp(6)
  updatedBy String?  @map("updated_by") @db.VarChar(255)

  @@map("general_configurations")
}

// Master Data Category - Used to categorize master data entries
model MasterDataCategory {
  id            String    @id @default(uuid()) @db.Uuid
  name          String    @db.VarChar(255)
  description   String?   @db.VarChar(255)
  code          String?   @db.VarChar(255)
  status        String    @db.VarChar(10) // active, inactive
  icon          String?   @db.VarChar(255)
  color         String?   @db.VarChar(255)
  isSystemFixed Boolean   @default(false) @map("is_system_fixed")
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamp(6)
  createdBy     String?   @map("created_by") @db.Uuid
  updatedBy     String?   @map("updated_by") @db.Uuid
  deletedAt     DateTime? @map("deleted_at") @db.Timestamp(6)

  masterDataEntries MasterData[]

