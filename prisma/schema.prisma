  updatedBy           String?   @map("updated_by") @db.Uuid
  deletedAt           DateTime? @map("deleted_at") @db.Timestamp(6)

  vendorType_rel     MasterData          @relation("VendorType", fields: [vendorTypeId], references: [id], onDelete: Restrict)
