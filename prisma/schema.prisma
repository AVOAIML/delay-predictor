// Master Data - Reference data entries used to populate dropdowns
model MasterData {
  id            String    @id @default(uuid()) @db.Uuid
  categoryId    String    @map("category_id") @db.Uuid
  name          String    @db.VarChar(255)
  description   String?   @db.VarChar(255)
  code          String?   @db.VarChar(255)
  status        String    @db.VarChar(10) // active, inactive
  icon          String?   @db.VarChar(255)
  color         String?   @db.VarChar(255)
  isSystemFixed Boolean   @default(false) @map("is_system_fixed")
  parentId      String?   @map("parent_id") @db.Uuid
  metadata      Json?     @db.JsonB
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamp(6)
  createdBy     String?   @map("created_by") @db.Uuid
  updatedBy     String?   @map("updated_by") @db.Uuid
  deletedAt     DateTime? @map("deleted_at") @db.Timestamp(6)

  category                   MasterDataCategory   @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  parent                     MasterData?          @relation("MasterDataParent", fields: [parentId], references: [id], onDelete: SetNull)
  children                   MasterData[]         @relation("MasterDataParent")
  formConfigurationsAsStatus FormConfiguration[]  @relation("FormConfigStatus")
  operationsAsOperationType  Operations[]         @relation("OperationType")
  workCentersWorkingHours    WorkCenter[]         @relation("WorkCenterWorkingHours")
  vendorTypes                Vendor[]             @relation("VendorType")
  vendorCountries            Vendor[]             @relation("VendorCountry")
  vendorStatuses             Vendor[]             @relation("VendorStatus")
  contactCountries           Contact[]            @relation("ContactCountry")
  contactShippingCountries   Contact[]            @relation("ContactShippingCountry")
  contactLifeCycleStatuses   Contact[]            @relation("ContactLifeCycleStatus")
  tenantStatuses             Tenant[]             @relation("TenantStatus")
  userStatuses               User[]               @relation("UserStatus")
  userTenantStatuses         UserTenant[]         @relation("UserTenantStatus")
  productsType               Product[]            @relation("ProductType")
  templateTypes              Template[]           @relation("TemplateType")
  templateStatuses           Template[]           @relation("TemplateStatus")
  quotationStages            Quotation[]          @relation("QuotationStage")
  quotationStatuses          Quotation[]          @relation("QuotationStatus")
  quotationPaymentTerms      Quotation[]          @relation("QuotationPaymentTerms")
  organisationCompanyTypes   Organisation[]       @relation("OrganisationCompanyType")
  organisationCountries      Organisation[]       @relation("OrganisationCountry")
  organisationStatuses       Organisation[]       @relation("OrganisationStatus")
  tenantSubscriptionStatuses TenantSubscription[] @relation("TenantSubscriptionStatus")
  moStatuses                 ManufacturingOrder[] @relation("MOStatus")
  moComponentStatuses        ManufacturingOrder[] @relation("MOComponentStatus")
  moComponentAvailabilities  MOComponent[]        @relation("MOComponentAvailability")
  workOrderStatuses          WorkOrder[]          @relation("WorkOrderStatus")
  integrationConnectionStatuses Integration[]      @relation("IntegrationConnectionStatus")
  templateMappingStatuses       TemplateMapping[]  @relation("TemplateMappingStatus")

  @@index([categoryId])
  @@index([code])
  @@index([status])
  @@index([parentId])
  @@map("master_data")
}

// Vendor Management - CRM Sales Domain
/// @deprecated — Legacy vendor model. New code should use Organisation with companyTypeId = ORGANISATION_TYPE_VENDOR or ORGANISATION_TYPE_BOTH.
