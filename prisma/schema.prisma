  name                String    @db.VarChar(255)
  email               String    @db.VarChar(255)
  organisationName    String?   @map("organisation_name") @db.VarChar(255)
  abnNo               String?   @map("abn_no") @db.VarChar(11) // Australian Business Number (optional)
  phone               String?   @db.VarChar(16)
  addressLine01       String?   @map("address_line_01") @db.VarChar(255)
  addressLine02       String?   @map("address_line_02") @db.VarChar(255)
  city                String?   @db.VarChar(100)
  state               String?   @db.VarChar(100)
  postalCode          String?   @map("postal_code") @db.VarChar(30)
  countryId           String?   @map("country_id") @db.Uuid // FK to master_data (COUNTRY)
