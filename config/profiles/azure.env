# APP_ENV=azure — deployed Azure Container Apps profile.
#
# Intentionally near-empty. Real values (PGHOST, PGPASS, JWT_SECRET,
# MLFLOW_TRACKING_URI, ...) are set as Container App environment variables /
# secrets, which pydantic-settings reads with higher priority than this file —
# see Settings._assemble_data_db_url in libs/maxxflow_core/settings.py for why.
# This file only needs to exist so APP_ENV=azure resolves to something instead
# of raising FileNotFoundError at import time.
APP_ENV=azure
