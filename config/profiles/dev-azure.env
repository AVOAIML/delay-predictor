# ---------------------------------------------------------------------------
# APP_ENV=dev-azure  — PHASE 2 SEAM (NOT built this release).
#
# This file documents the env-swap that flips the SAME code from local to Azure
# with zero module edits (plan §11). It is intentionally full of TODO markers:
# the Phase-2 Bicep (infra/) emits these values. Do NOT fill guesses in here.
# Every <...> below needs your Azure resources / credentials to go live.
# ---------------------------------------------------------------------------
APP_ENV=dev-azure

# Feature data source = PostgreSQL Flexible Server READ REPLICA (never primary).
# TODO(azure): replica FQDN + Entra/managed-identity auth. ML reads the replica.
DATA_DB_URL=postgresql+psycopg://<user>@<replica-fqdn>:5432/maxxflow?sslmode=require
DATA_DB_IS_REPLICA=true

# Lake = ADLS Gen2 (HNS on). Only the protocol changes (abfss:// vs s3://).
# TODO(azure): storage account + container; auth via managed identity.
LAKE_URI=abfss://<container>@<account>.dfs.core.windows.net/maxxflow-lake
LAKE_ENDPOINT_URL=

# Tenant artifact store (M3 snapshots / outcomes) — Azure container "dev".
# TODO(azure): storage account name. Auth: AZURE_STORAGE_CONNECTION_STRING if
# set (a secret — never in this file), else the app's managed identity.
AZURE_STORAGE_CONTAINER=dev
AZURE_STORAGE_ACCOUNT=
AZURE_STORAGE_PREFIX=maxxflow-lake

# MLflow tracking/registry = the Azure ML workspace (MLflow-compatible).
# TODO(azure): azureml://<subscription>/<rg>/<workspace> tracking URI.
MLFLOW_TRACKING_URI=azureml://<region>.api.azureml.ms/mlflow/v1.0/subscriptions/<sub>/resourceGroups/<rg>/providers/Microsoft.MachineLearningServices/workspaces/<ws>
MLFLOW_REGISTRY_URI=
MODEL_ALIAS=champion

# Providers: Azure OpenAI recommended (region/governance). Text generation only.
# VERIFY-BEFORE-BUILDING (plan §12a #12): confirm the model id is deployed in the
# intended region BEFORE relying on it. Leave blank until verified.
LLM_PROVIDER=azure_openai
LLM_MODEL_ID=                      # TODO(verify): e.g. the deployed Claude Sonnet 4.6 (Foundry) or gpt-4o deployment name
EMBEDDING_PROVIDER=azure_openai
EMBEDDINGS_ENABLED=false           # keep OFF until text-embedding-3-small AU-East deployability is VERIFIED
EMBEDDING_MODEL_ID=                # TODO(verify): text-embedding-3-small deployment name (AU East)

# Secret: pull HMAC_SALT from Key Vault (must equal the local salt for parity).
HMAC_SALT=                         # TODO(azure): Key Vault secret reference

DEFAULT_TENANT=demo
TENANT_SCHEMA_PREFIX=tenant_
PRESENTATION_TZ=Australia/Sydney
MODEL_LRU_SIZE=8
