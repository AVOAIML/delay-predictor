# ---------------------------------------------------------------------------
# APP_ENV=local  — everything runs on the docker-compose stack, ZERO Azure.
# Loaded by maxxflow_core.settings when APP_ENV=local (the default).
# Override secrets in .env.local (gitignored).
# ---------------------------------------------------------------------------
APP_ENV=local

# Feature data source: the local postgres container (loaded from schema.prisma).
# Locally we read the same DB we write; in prod this points at the read REPLICA.
DATA_DB_URL=postgresql+psycopg://maxxflow:maxxflow@localhost:5432/maxxflow
DATA_DB_IS_REPLICA=false

# Medallion lake: MinIO (S3 API). Only the protocol differs from ADLS abfss://.
LAKE_URI=s3://maxxflow-lake
LAKE_KEY=minioadmin
LAKE_SECRET=minioadmin
LAKE_ENDPOINT_URL=http://localhost:9000

# Tenant artifact store (M3 snapshots / outcomes). "local" = the MinIO lake
# above; any other value is an Azure container (code default: "dev").
AZURE_STORAGE_CONTAINER=local

# MLflow: self-hosted server (same MLflow API as the Azure ML workspace).
# Host port 8085 (avoids macOS AirPlay :5000 and Chrome's unsafe :5060/:5061).
MLFLOW_TRACKING_URI=http://localhost:8085
MLFLOW_REGISTRY_URI=http://localhost:8085
MODEL_ALIAS=champion

# Providers: deterministic stubs. NEVER call a paid API locally/CI.
LLM_PROVIDER=stub
EMBEDDING_PROVIDER=stub
EMBEDDINGS_ENABLED=false

# Determinism: pinned HMAC salt so operator->tier is reproducible local==prod.
HMAC_SALT=local-dev-salt-change-me

DEFAULT_TENANT=demo
TENANT_SCHEMA_PREFIX=tenant_
PRESENTATION_TZ=Australia/Sydney
MODEL_LRU_SIZE=8
